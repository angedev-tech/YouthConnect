# ═══════════════════════════════════════════════════════════════════
#  YouthConnect — modèle de configuration
#
#  ⚠️ Ce fichier ne contient que des EMPLACEMENTS. Ne mets jamais de vraie
#  valeur ici, ni dans le code, ni dans GitHub.
#
#  Où mettre chaque valeur : Vercel → Project → Settings → Environment Variables
#  (en choisissant l'environnement : Production, Preview ou Development).
#  En local uniquement : copie ce fichier en « .env.local » (ignoré par Git).
#  Détails : docs/SECRETS.md
# ═══════════════════════════════════════════════════════════════════

# ── Publiques : utilisables dans le navigateur (via /api/config) ──
# Adresse du projet Supabase (Settings → API)
SUPABASE_URL=https://<identifiant-du-projet>.supabase.co
# Clé PUBLIABLE (commence par sb_publishable_). Jamais la clé secrète ici.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<ta-cle-publiable>

# ── Privées : serveur uniquement (Vercel, jamais dans le code) ──
# Clé SECRÈTE Supabase (commence par sb_secret_). Contourne RLS : très sensible.
SUPABASE_SECRET_KEY=sb_secret_<ta-cle-secrete>
# Secret du hook d'e-mail : copie la valeur affichée dans Supabase
# (Authentication → Hooks → Send Email), forme « v1,whsec_… »
SEND_EMAIL_HOOK_SECRET=v1,whsec_<secret-du-hook>
# Clé API Resend (commence par re_)
RESEND_API_KEY=re_<ta-cle-resend>
# Clé de hachage des adresses IP (au moins 32 caractères aléatoires)
IP_HASH_SECRET=<chaine-aleatoire-d-au-moins-32-caracteres>

# ── SMS (vérification du téléphone) ──
# Secret du hook SMS : copie la valeur affichée dans Supabase (Authentication → Hooks → Send SMS)
SEND_SMS_HOOK_SECRET=v1,whsec_<secret-du-hook-sms>
# Compte Twilio (Account SID commence par AC ; jeton d'authentification : 32 caractères)
TWILIO_ACCOUNT_SID=AC<identifiant-du-compte-twilio>
TWILIO_AUTH_TOKEN=<jeton-d-authentification-twilio>
# Expéditeur. Recommandé : un service de messagerie (commence par MG).
TWILIO_MESSAGING_SERVICE_SID=MG<identifiant-du-service>
# Sinon : un numéro au format international, ou un nom d'expéditeur de 11 caractères maximum
# TWILIO_FROM=YOUTHCONN
# Plafond quotidien global d'SMS (protection contre la fraude)
SMS_DAILY_LIMIT=500

# ── Envoi d'e-mails ──
# Expéditeur. TEST uniquement : onboarding@resend.dev ne livre qu'à l'adresse du compte Resend.
# En production, remplace-le par ton domaine vérifié (docs/EMAIL-ET-DOMAINE.md).
EMAIL_FROM=YouthConnect <onboarding@resend.dev>
# Adresse publique du site, utilisée dans les liens des e-mails (https en production)
APP_URL=https://<ton-site>.vercel.app

# ── Automatique ──
# Fourni par Vercel (production, preview ou development) : ne pas le définir à la main
# VERCEL_ENV=
